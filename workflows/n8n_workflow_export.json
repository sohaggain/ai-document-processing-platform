        "rules": {
          "rules": [
            { "value2": "invoice", "output": 0 },
            { "value2": "contract", "output": 1 },
            { "value2": "resume", "output": 2 },
            { "value2": "form", "output": 3 }
          ]
        }
      },
      "name": "Switch: document_type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Verify Signature", "type": "main", "index": 0 }]] },
    "Verify Signature": { "main": [[{ "node": "Switch: document_type", "type": "main", "index": 0 }]] }
  },
  "note": "This is a sanitized template export. No credentials are included. Configure CRM/ATS/Slack credentials and downstream nodes per output branch after import."
