{
  "name": "Document Processing - Downstream Router",
  "nodes": [
    {
      "parameters": {
        "path": "document-processed",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
