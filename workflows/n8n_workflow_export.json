        "functionCode": "// Verify X-Signature header against HMAC-SHA256 of the raw body\n// using the WEBHOOK_SIGNING_SECRET credential before proceeding.\n// Reject (throw) if the signature does not match.\nreturn items;"
      },
      "name": "Verify Signature",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
